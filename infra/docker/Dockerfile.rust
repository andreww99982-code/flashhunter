# FlashHunter: Rust-сервисы (ингестор, индекс пулов, граф, симулятор, bundle, релеи).
# Один образ на все бинарники: в compose/k8s выбирается конкретный bin через command.
# Ступени: builder (сборка релиза) → runtime (минимальный debian-slim).

FROM rust:1.82-slim AS builder

WORKDIR /src

RUN apt-get update \
 && apt-get install -y --no-install-recommends pkg-config libssl-dev \
 && rm -rf /var/lib/apt/lists/*

# Манифесты отдельным слоем: кэш зависимостей переживает правки кода
COPY rust/Cargo.toml rust/rust-toolchain.toml ./
COPY rust/crates/ ./crates/
RUN cargo build --release --workspace

# ---------------------------------------------------------------------------
FROM debian:12-slim AS runtime

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --create-home --uid 10002 flashhunter

WORKDIR /app
COPY --from=builder /src/target/release/fh-ingestor /usr/local/bin/fh-ingestor

ENV RUST_LOG=info \
    FLASHHUNTER_ENV=prod

USER flashhunter
# tini как PID 1: корректная передача SIGTERM (важно для graceful shutdown)
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["fh-ingestor"]
