# Сгенерировано Ansible из шаблона roles/flashhunter/templates/env.j2.
# Ручные правки будут перезаписаны при следующем деплое!
# Секреты подставляются из vault и AWS Secrets Manager, НЕ из этого файла.

# --- Окружение ----------------------------------------------------------- #
FLASHHUNTER_ENV={{ flashhunter_env }}
FLASHHUNTER_LOG_LEVEL={{ flashhunter_log_level }}
FLASHHUNTER_LOG_JSON={{ flashhunter_log_json }}
FLASHHUNTER_INSTANCE_ID={{ inventory_hostname }}
FLASHHUNTER_DRY_RUN={{ flashhunter_dry_run }}
FLASHHUNTER_FORCE_PASSWORD_CHANGE={{ flashhunter_force_password_change }}
FLASHHUNTER_AUTO_OPEN_BROWSER=false

# --- Хранилища ----------------------------------------------------------- #
FLASHHUNTER_DB_MODE=postgres
POSTGRES_DSN=postgresql+asyncpg://{{ postgres_user }}:{{ vault_postgres_password }}@postgres:5432/{{ postgres_db }}
CLICKHOUSE_DSN=clickhouse://{{ postgres_user }}:{{ vault_clickhouse_password }}@clickhouse:8123/{{ clickhouse_db }}
REDIS_URL=redis://redis:6379/0
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_DB={{ postgres_db }}
CLICKHOUSE_USER={{ postgres_user }}
CLICKHOUSE_PASSWORD={{ vault_clickhouse_password }}
CLICKHOUSE_DB={{ clickhouse_db }}

# --- API и безопасность -------------------------------------------------- #
API_HOST=0.0.0.0
API_PORT={{ api_port | default(8000) }}
JWT_SECRET={{ vault_jwt_secret }}
JWT_TTL_MINUTES=720
SESSION_COOKIE_SECURE=true
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD={{ vault_admin_password }}
CORS_ORIGINS=https://{{ zone_name | default('flashhunter.example.com') }}

# --- RPC-провайдеры ------------------------------------------------------ #
ETH_RPC_HTTP={{ vault_eth_rpc_http }}
ETH_RPC_WS={{ vault_eth_rpc_ws }}
ARB_RPC_HTTP={{ vault_arb_rpc_http }}
BASE_RPC_HTTP={{ vault_base_rpc_http }}

# --- Релеи --------------------------------------------------------------- #
FLASHBOTS_RELAY_URL=https://relay.flashbots.net
FLASHBOTS_AUTH_KEY={{ vault_flashbots_auth_key }}
BLOXROUTE_RELAY_URL=https://mev.api.blxrbdn.com
BLOXROUTE_AUTH_HEADER={{ vault_bloxroute_auth_header }}
TITAN_RELAY_URL=https://rpc.titanbuilder.xyz
RELAY_TIMEOUT_MS=250

# --- Риск-лимиты --------------------------------------------------------- #
RISK_DAILY_LOSS_LIMIT_USD={{ risk_daily_loss_limit_usd }}
RISK_HOURLY_LOSS_LIMIT_USD={{ risk_hourly_loss_limit_usd }}
RISK_MAX_EXPOSURE_PER_CHAIN_USD={{ risk_max_exposure_per_chain_usd }}
RISK_MAX_EXPOSURE_PER_TOKEN_USD={{ risk_max_exposure_per_token_usd }}
RISK_REVERT_RATE_LIMIT_PCT=35
RISK_AUTO_SWEEP_INTERVAL_SEC=3600

# --- Исполнение ---------------------------------------------------------- #
EXEC_MIN_PROFIT_USD={{ exec_min_profit_usd }}
EXEC_MAX_GAS_GWEI={{ exec_max_gas_gwei }}
EXEC_REPLACEMENT_BUMP_PCT={{ exec_replacement_bump_pct }}
EXEC_MAX_SLIPPAGE_BPS={{ exec_max_slippage_bps }}
EXEC_SIM_TIMEOUT_MS=800
COLD_WALLET_ADDRESS={{ vault_cold_wallet_address }}
SWEEP_MIN_AMOUNT_USD=250

# --- Данные -------------------------------------------------------------- #
MOCK_MARKET_DATA=false

# --- Наблюдаемость и уведомления ----------------------------------------- #
PROMETHEUS_PORT={{ prometheus_port }}
GRAFANA_PORT={{ grafana_port }}
GRAFANA_USER=admin
GRAFANA_PASSWORD={{ vault_grafana_password }}
ALERT_TELEGRAM_TOKEN={{ vault_alert_telegram_token | default('') }}
ALERT_TELEGRAM_CHAT_ID={{ vault_alert_telegram_chat_id | default('') }}
ALERT_DISCORD_WEBHOOK={{ vault_alert_discord_webhook | default('') }}
BACKUP_BUCKET={{ backup_bucket }}
