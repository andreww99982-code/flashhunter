# Реальные данные блокчейна; dry-run защищает от отправки транзакций.
FLASHHUNTER_ENV=prod
FLASHHUNTER_LOG_LEVEL=INFO
FLASHHUNTER_LOG_JSON=false
FLASHHUNTER_DRY_RUN=true
FLASHHUNTER_AUTO_OPEN_BROWSER=false
FLASHHUNTER_FORCE_PASSWORD_CHANGE=true
FLASHHUNTER_DB_MODE=sqlite
SQLITE_PATH=./data/flashhunter.db
API_PORT=8000

# Bootstrap заменит JWT и пароли случайными значениями.
JWT_SECRET=change-me-in-production-please-32-chars
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin

# Мок-рынок выключен. Укажите приватный RPC для надёжной работы;
# для Ethereum доступны публичные fallback RPC, если ETH_RPC_HTTP пуст.
MOCK_MARKET_DATA=false
ETH_RPC_HTTP=
ETH_RPC_FALLBACKS=https://eth.drpc.org,https://eth-mainnet.public.blastapi.io,https://ethereum-rpc.publicnode.com,https://rpc.flashbots.net
ETH_RPC_WS=
LIVE_CHAIN_ID=1
LIVE_WS_PENDING_TXS=false
KEEPER_PRIVATE_KEY=
KEEPER_KEY_FILE=
FLASHLOAN_ARBITRAGE_ADDRESS=
ARB_RPC_HTTP=
BASE_RPC_HTTP=

# Лимиты риска и исполнения.
RISK_DAILY_LOSS_LIMIT_USD=500
RISK_HOURLY_LOSS_LIMIT_USD=150
EXEC_MIN_PROFIT_USD=5
EXEC_MAX_GAS_GWEI=120
COLD_WALLET_ADDRESS=

# Необязательные кластерные хранилища.
POSTGRES_USER=flashhunter
POSTGRES_PASSWORD=flashhunter
POSTGRES_DB=flashhunter
POSTGRES_DSN=
CLICKHOUSE_USER=flashhunter
CLICKHOUSE_PASSWORD=flashhunter
CLICKHOUSE_DB=flashhunter
CLICKHOUSE_DSN=clickhouse://clickhouse:8123/flashhunter
REDIS_URL=redis://redis:6379/0

# Необязательные сервисы наблюдаемости.
GRAFANA_USER=admin
GRAFANA_PASSWORD=flashhunter
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_DISCORD_WEBHOOK=
ALERT_WEBHOOK_URL=
